SUPABASE_URL=https://your-project.supabase.co
# Backend secret key (sb_secret_...), not the publishable key.
SUPABASE_SECRET_KEY=
# Existing setups can alternatively use SUPABASE_KEY with a legacy service_role key.
# Never put either backend key in frontend environment variables.
# The passwordless switcher is OFF unless both settings below enable it.
APP_ENV=production
DEV_ROLE_SWITCHER_ENABLED=false
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# Port 5000 is used by AirPlay on macOS.
FLASK_RUN_PORT=5001
